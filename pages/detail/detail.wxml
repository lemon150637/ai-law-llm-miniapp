<view class="page"><view class="card"><text class="article-no">{{article.articleNo}}</text><text class="hero-title detail-title">{{article.title}}</text><text class="meta">{{article.lawName}} · {{article.chapter}} · {{article.effective}}</text><view class="article-text">{{article.content}}</view><view class="tag-row"><text class="tag" wx:for="{{article.keywordList}}" wx:key="*this">{{item}}</text></view></view><view class="card"><view class="section-title">条文分析</view><button class="primary" bindtap="analyze">{{loading ? '分析中…' : '调用大模型分析'}}</button><view wx:if="{{analysis}}" class="analysis">{{analysis}}</view></view><view wx:if="{{interpretations.length}}" class="card"><view class="section-title">相关司法解释</view><block wx:for="{{interpretations}}" wx:key="id"><view class="interpretation"><text class="result-title">{{item.title}}</text><text class="meta">{{item.documentNo}} · {{item.status}} · {{item.effectiveDate}}</text><text class="result-content">{{item.summary}}</text></view></block></view></view>
