<view class="page">
  <view class="hero"><text class="eyebrow">CIVIL LAW · PRECISION SEARCH</text><text class="hero-title">法条智检</text><text class="hero-desc">把事实问题，落到最相关的民法条文上。</text></view>
  <view class="card"><view class="search-box"><input value="{{query}}" placeholder="描述你的问题，例如：合同未盖章是否有效" confirm-type="search" bindinput="onInput" bindconfirm="onSearch"/><button class="search-btn" size="mini" bindtap="onSearch">检索</button></view><view class="chips"><block wx:for="{{hot}}" wx:key="*this"><view class="chip" data-q="{{item}}" bindtap="onHot">{{item}}</view></block></view></view>
  <view class="card"><view class="section-title">{{searched ? '相关条文' : '示例条文'}} <text style="font-weight:normal;color:#8796a0;font-size:24rpx">共 {{results.length}} 条</text></view><block wx:for="{{results}}" wx:key="id"><view class="result" data-item="{{item}}" bindtap="openDetail"><view class="result-head"><view><text class="article-no">{{item.articleNo}}</text><text class="result-title">{{item.title}}</text></view><text wx:if="{{searched}}" class="score">匹配 {{item.score}}%</text></view><text class="result-content">{{item.content}}</text><text class="meta">{{item.lawName}} · {{item.chapter}}</text></view></block><view wx:if="{{!results.length}}" class="empty">暂未找到匹配条文，换个说法试试</view></view>
  <view class="card"><view class="section-title">数据与分析</view><view class="notice">当前已加载 {{articleCount}} 条示例数据。支持导入 JSON，并可在“分析”页配置后端大模型接口。</view><button class="primary" bindtap="goImport">导入我的 JSON 数据</button></view>
</view>
